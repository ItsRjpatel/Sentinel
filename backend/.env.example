PROJECT_NAME="Sentinel API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database
# Example Neon PostgreSQL URL
DATABASE_URL="postgresql+asyncpg://<username>:<password>@<host>/<database>?sslmode=require&channel_binding=require"

# JWT Auth
JWT_SECRET_KEY="<your_jwt_secret_key_here>"
BOOTSTRAP_ADMIN_PASSWORD="<your_bootstrap_admin_password_here>"

# Logging
LOG_LEVEL="INFO"
